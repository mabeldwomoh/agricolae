# Normality Distribution in Sas
proc univariate data=IMPORT normal plot;
    var Stand;
    histogram Stand/ normal;
    probplot Stand / normal;
run;

# Normality Distribution in R 
shapiro.test(data$Stand)

# Repeated Measures and comparison of means in sas 
proc glimmix data=IMPORT;
    class Rep Date Variety;
    model Stand = Variety Date Variety*Date / ddfm=kr;
    random Rep Rep*Variety;
 lsmeans Variety Date / pdiff adjust=tukey lines;
run;
